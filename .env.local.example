# Cloudinary credentials
# Get these from https://cloudinary.com/console after signing up
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Analytics (optional — tracking stays off until these are set)
# GA4: analytics.google.com → Admin → Data streams → Measurement ID
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
# Microsoft Clarity: clarity.microsoft.com → Settings → Overview → Project ID
NEXT_PUBLIC_CLARITY_ID=xxxxxxxxxx
